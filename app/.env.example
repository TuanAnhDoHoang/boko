# ============================================================================
# BOKO WEB — CẤU HÌNH MÔI TRƯỜNG (MẪU)
#
#   cp .env.example .env    rồi điền giá trị thật vào .env
#
# .env đã bị .gitignore chặn — KHÔNG BAO GIỜ commit file này.
# Biến VITE_* được "bake" vào bundle lúc build nên đổi env phải build lại.
# ============================================================================

# URL backend API (Render). Để trống = web chạy mock localStorage, không gọi API.
VITE_BACKEND_URL=http://localhost:8080

# PayPal Client ID (public). Có giá trị = hiện nút PayPal thật; trống = mock.
VITE_PAYPAL_CLIENT_ID=

# Google OAuth Client ID (public), dùng cho nút đăng nhập Google
VITE_GOOGLE_CLIENT_ID=
