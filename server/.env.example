# ============================================================================
# BOKO API — CẤU HÌNH MÔI TRƯỜNG (MẪU)
#
#   cp .env.example .env    rồi điền giá trị thật vào .env
#
# .env đã bị .gitignore chặn — KHÔNG BAO GIỜ commit file này.
# Trên Render/Vercel thì set từng biến trong mục Environment Variables.
# ============================================================================

# --- Database (Neon / Render) ---
# Ưu tiên 1: nguyên connection string (Neon cấp sẵn).
# Ví dụ: postgresql://neondb_owner:xxx@ep-xxx-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# Cách 2 (fallback): ráp từng biến — chỉ dùng khi KHÔNG set DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=boko_db
# Neon/managed DB bắt buộc require; local docker dùng disable
DB_SSLMODE=disable
# Neon yêu cầu channel_binding=require khi connection string có nó
DB_CHANNEL_BINDING=
# Neon pooler (pgbouncer) không hỗ trợ prepared statement → bật true
DB_SIMPLE=true

# --- Mã hóa dữ liệu nhạy cảm (BẮT BUỘC) ---
# AES-256-GCM key cho users.name/phone, orders.phone/shipping_address.
# Tạo key:  openssl rand -base64 32
# ⚠ Thiếu biến này = EncryptString trả lỗi, khách không đăng ký được.
# ⚠ Đổi key = toàn bộ dữ liệu đã mã hóa cũ không giải mã được nữa.
APP_AES_KEY=
# Alias cũ, chỉ dùng 1 trong 2
AES_KEY=

# --- Server ---
# Cổng lắng nghe (hardcode :8080 trong main.go, dùng nếu sau này đọc biến)
PORT=8080

# --- PayPal ---
# Client ID là public (nằm trong bundle frontend). Secret chỉ để trên server.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- MoMo (để trống = dùng key test sandbox công khai có sẵn trong code) ---
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_QUERY_URL=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

# --- VNPay (để trống = dùng key test sandbox công khai có sẵn trong code) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-callback
VNPAY_IPN_URL=http://localhost:8080/api/payment/vnpay/ipn

# --- Tài khoản seed (KHÔNG hardcode mật khẩu trong code nữa) ---
# Backend tạo admin@boko.com / test@gmail.com từ 2 mật khẩu này (bcrypt).
# Để trống = bỏ qua, tài khoản đó không được tạo.
SEED_ADMIN_EMAIL=admin@boko.com
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=test@gmail.com
SEED_CUSTOMER_PASSWORD=
# =true: đồng bộ lại mật khẩu seed từ env cho tài khoản đã tồn tại
# (dùng sau khi chạy migrations/0002_seed_data.sql để đặt mật khẩu thật).
# Mặc định tắt để không vô tình reset mật khẩu khi restart.
SEED_UPDATE_PASSWORD=false

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=